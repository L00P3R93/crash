APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# Redis-backed so Horizon (installed for Phase 5's admin panel) can monitor
# the queue; requires a running Redis server, see REDIS_* below.
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

# Phase 6's web/WebSocket client — self-hosted via `php artisan reverb:start`.
# Generate real values with `php artisan reverb:install` (or by hand) per
# environment; never share the .env ones across dev/staging/production.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# If the app is served over HTTPS (e.g. Herd/Valet), REVERB_HOST/SCHEME above
# must point at a real wss:// endpoint — browsers block a plain ws:// socket
# as mixed content when opened from an https:// page, even to loopback.
# Set REVERB_HOST to the app's real hostname, REVERB_SCHEME=https, and give
# Reverb its own TLS cert for that hostname via these two (see
# config/reverb.php's `servers.reverb.options.tls`):
# REVERB_TLS_CERT=
# REVERB_TLS_KEY=

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Aviator game
AVIATOR_HOUSE_EDGE=0.03
AVIATOR_MIN_STAKE=10
AVIATOR_MAX_STAKE=2000
AVIATOR_MAX_MULTIPLIER=5000
AVIATOR_BETTING_WINDOW_SECONDS=25
AVIATOR_POST_ROUND_PAUSE_SECONDS=15
AVIATOR_ACCELERATION_K=0.25
AVIATOR_WINNINGS_TAX_RATE=0.20
# Local/dev only — makes the seeded bot accounts (php artisan db:seed
# --class=BotPlayerSeeder) actually play every round. Leave off elsewhere.
AVIATOR_BOTS_ENABLED=false
AVIATOR_BOTS_MIN_PLAYERS=20
AVIATOR_BOTS_MAX_PLAYERS=40
AVIATOR_BOTS_MIN_AUTO_CASHOUT=1.10
AVIATOR_BOTS_MAX_AUTO_CASHOUT=10.00

# M-Pesa Daraja
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_STK_CALLBACK_URL=
MPESA_B2C_RESULT_URL=
MPESA_B2C_TIMEOUT_URL=
MPESA_INITIATOR_NAME=
MPESA_INITIATOR_PASSWORD=
MPESA_ALLOWED_IPS=
MPESA_MIN_TOPUP=50
MPESA_MAX_TOPUP=10000
MPESA_MIN_WITHDRAWAL=50
MPESA_MAX_WITHDRAWAL=10000

# Africa's Talking
AT_USERNAME=
AT_API_KEY=
AT_ENVIRONMENT=sandbox
AT_SERVICE_CODE="*384*1234#"
AT_SHARED_SECRET=
AT_SESSION_TTL_SECONDS=180

# Read by database/seeders/SntaksAdminUserSeeder.php. Leave blank in any
# shared/example env — real credentials belong only in the untracked local
# .env for whichever environment actually runs that seeder.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
